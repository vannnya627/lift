###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/mongodb-odm-bundle ###
MONGODB_DB=lift
MONGODB_USER=root
MONGODB_PASSWORD=12345
MONGODB_URI="mongodb://${MONGODB_USER}:${MONGODB_PASSWORD}@database:27017/${MONGODB_DB}?authSource=admin"
###< doctrine/mongodb-odm-bundle ###

###> symfony/messenger ###
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/"
###< symfony/messenger ###


